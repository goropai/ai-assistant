# Налаштування збірки (не комітиться). API-ключі сюди НЕ пишемо —
# вони вводяться на телефоні: довге натискання на обличчя -> налаштування.

# Моделі за замовчуванням (на телефоні можна змінити)
claude.model=claude-sonnet-5-5
# low = найшвидша відповідь для голосу; medium/high — розумніше, але повільніше
claude.effort=low
gemini.model=gemini-2.5-flash

# Голос: висота (1.0 = звичайна) та швидкість мовлення
tts.pitch=1.3
tts.rate=1.05
# Необов'язково: точна назва голосу TTS (див. логи тегу Speaker)
tts.voice=

# Яскравість екрана 0.0..1.0 (-1 = системна). Менше = довше живе батарея.
screen.brightness=0.15

# Самооновлення: адреса update.json. За замовчуванням — останній реліз на GitHub
# (speedy.updateManifestUrl у gradle.properties). Порожній рядок тут не перевизначає.
# update.manifestUrl=http://192.168.1.10:8000/update.json

# Ключ підпису релізів (файл поза репозиторієм; ЗБЕРЕЖИ РЕЗЕРВНУ КОПІЮ — без нього
# встановлений застосунок неможливо оновити)
signing.properties=D:/path/to/speedy-signing.properties
