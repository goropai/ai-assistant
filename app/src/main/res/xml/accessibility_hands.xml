<?xml version="1.0" encoding="utf-8"?>
<!-- Керування застосунками голосом: читати вміст вікна й натискати — лише за командою людини. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeViewClicked|typeViewLongClicked|typeViewScrolled"
