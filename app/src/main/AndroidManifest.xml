<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Повернути Спіді на екран із фону (відео в іншому застосунку скінчилось): startActivity там не діє. -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <!-- Погода й "де ми": GPS і мережеве визначення місця -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Розумний дім: датчики Tuya лише з Bluetooth — Спіді читає їх сама (вмикає Bluetooth, коли треба). -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- "Який номер у Кості?", "що в мене сьогодні в календарі?", будильник і таймер -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- "Запиши в календар лікаря на п'ятницю о 10" -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Вібрація: нагадування в тиші, "де ти?", дотик, уроки (кожну можна вимкнути) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Режим сторожа: тривога SMS і дзвінком на номер, вказаний у налаштуваннях (лише за PIN) -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- Самооновлення: потрібен на Android 8+, на 7.1 діє глобальне "Невідомі джерела" -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Книги вголос: шукаємо файли по всьому сховищу (Android 11+ — "доступ до всіх файлів") -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <!-- Android 11+: бачити VLC (фільми й аудіокниги грає він) -->
    <queries>
        <package android:name="org.videolan.vlc" />
        <!-- Відео з інтернету: YouTube, якщо встановлений, інакше NewPipe -->
        <package android:name="com.google.android.youtube" />
        <package android:name="org.schabi.newpipe" />
        <package android:name="org.polymorphicshade.tubular" />
        <package android:name="org.polymorphicshade.newpipe" />
    </queries>

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- usesCleartextTraffic: платформа на ESP32 у локальній мережі говорить простим HTTP -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Speedy"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullSensor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Сповіщення інших застосунків ("що нового?") — доступ вмикає людина в налаштуваннях -->
        <service
            android:name=".phone.SpeedyNotifications"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Керування застосунками голосом — службу вмикає людина (спеціальні можливості) -->
        <service
            android:name=".phone.SpeedyHands"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_hands" />
        </service>

        <!-- Після оновлення — одразу назад на екран (інакше виглядає як падіння) -->
        <receiver
            android:name=".update.RestartAfterUpdate"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Віддає завантажений APK системному інсталятору (file:// заборонено з Android 7) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
